---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { parseOrigins } from '../../lib/origin';
import { useTranslations } from '../../i18n';

const t = useTranslations();
const entries = await getCollection('names');
const origins = [...new Set(entries.flatMap((e) => parseOrigins(e.data.origin)))].sort((a, b) =>
  a.localeCompare(b),
);

const pickerData = JSON.stringify(
  entries.map((e) => ({
    id: e.id,
    name: e.data.name,
    gender: e.data.gender,
    origin: e.data.origin,
    meaning: e.data.meaning,
  })),
);
---

<BaseLayout title={t('random.title')} description={t('random.lead')}>
  <h1 class="md-typescale-display-medium head">{t('random.title')}</h1>
  <p class="prose lead md-typescale-body-large">{t('random.lead')}</p>

  <div id="picker" class="picker">
    <div class="filters">
      <md-outlined-select data-gender label={t('random.gender')}>
        <md-select-option value="any" selected>
          <div slot="headline">{t('random.any')}</div>
        </md-select-option>
        <md-select-option value="female">
          <div slot="headline">{t('gender.female')}</div>
        </md-select-option>
        <md-select-option value="male">
          <div slot="headline">{t('gender.male')}</div>
        </md-select-option>
        <md-select-option value="unisex">
          <div slot="headline">{t('gender.unisex')}</div>
        </md-select-option>
      </md-outlined-select>

      <md-outlined-select data-origin label={t('random.origin')}>
        <md-select-option value="any" selected>
          <div slot="headline">{t('random.any')}</div>
        </md-select-option>
        {
          origins.map((origin) => (
            <md-select-option value={origin}>
              <div slot="headline">{origin}</div>
            </md-select-option>
          ))
        }
      </md-outlined-select>

      <md-filled-button data-pick>{t('random.pick')}</md-filled-button>
    </div>

    <div data-result class="result"></div>
  </div>

  <script type="application/json" id="picker-data" set:html={pickerData} />
  <script>
    import { initRandomPicker } from '../../scripts/random';

    const dataEl = document.getElementById('picker-data');
    const root = document.getElementById('picker');
    if (dataEl?.textContent && root) {
      initRandomPicker(root, JSON.parse(dataEl.textContent));
    }
  </script>
</BaseLayout>

<style>
  .head {
    padding-top: var(--space-5);
  }

  .lead {
    margin-top: var(--space-2);
    margin-bottom: var(--space-4);
    color: var(--md-sys-color-on-surface-variant);
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
  }

  md-outlined-select {
    min-width: 14rem;
  }

  .result:empty {
    display: none;
  }
</style>
