---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import GenderMark from '../../components/GenderMark.astro';
import { getParent, getRelated, getRootSiblings } from '../../lib/related';
import { useTranslations } from '../../i18n';

export async function getStaticPaths() {
  const names = await getCollection('names');
  return names.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { data } = entry;
const allNames = await getCollection('names');
const parent = getParent(entry, allNames);
const rootSiblings = getRootSiblings(entry, allNames);
const related = getRelated(entry, allNames);
const t = useTranslations();
---

<BaseLayout title={data.name} description={`${data.name}: ${data.meaning} (${data.origin}).`}>
  <article class="entry">
    <header class="entry-header">
      <GenderMark gender={data.gender} />
      <h1 class="md-typescale-display-large">{data.name}</h1>
      {
        data.pronunciation && (
          <p class="pronunciation md-typescale-title-large">{data.pronunciation}</p>
        )
      }
    </header>

    <div class="entry-body">
      <div class="prose">
        <section class="meaning">
          <p class="md-typescale-headline-small">{data.meaning}</p>
          <p class="md-typescale-body-medium origin">{t('entry.origin')}: {data.origin}</p>
        </section>

        <p>{data.description}</p>

        {
          data.variants && data.variants.length > 0 && (
            <p class="variants md-typescale-body-medium">
              <strong>{t('entry.variants')}:</strong> {data.variants.join(', ')}
            </p>
          )
        }
      </div>

      <aside class="rail">
        {
          parent && (
            <section>
              <h2 class="md-typescale-title-small">{t('entry.parent')}</h2>
              <md-list>
                <md-list-item type="link" href={`/names/${parent.id}/`}>
                  <div slot="headline">{parent.data.name}</div>
                  <span slot="end">
                    <GenderMark gender={parent.data.gender} />
                  </span>
                </md-list-item>
              </md-list>
            </section>
          )
        }

        {
          data.root && (
            <section>
              <h2 class="md-typescale-title-small">{t('entry.root')}</h2>
              <p class="root-value md-typescale-title-large">{data.root}</p>
              {rootSiblings.length > 0 && (
                <md-list>
                  {rootSiblings.map((r) => (
                    <md-list-item type="link" href={`/names/${r.id}/`}>
                      <div slot="headline">{r.data.name}</div>
                      <span slot="end">
                        <GenderMark gender={r.data.gender} />
                      </span>
                    </md-list-item>
                  ))}
                </md-list>
              )}
            </section>
          )
        }

        <section>
          <h2 class="md-typescale-title-small">{t('entry.related')}</h2>
          {
            related.length > 0 ? (
              <md-list>
                {related.map((r) => (
                  <md-list-item type="link" href={`/names/${r.id}/`}>
                    <div slot="headline">{r.data.name}</div>
                    <span slot="end">
                      <GenderMark gender={r.data.gender} />
                    </span>
                  </md-list-item>
                ))}
              </md-list>
            ) : (
              <p class="none md-typescale-body-medium">{t('entry.noRelated')}</p>
            )
          }
        </section>
      </aside>
    </div>
  </article>
</BaseLayout>

<style>
  .entry-header {
    padding-block: var(--space-5) var(--space-3);
  }

  .entry-header h1 {
    margin-top: var(--space-1);
  }

  .pronunciation {
    margin-top: var(--space-1);
    color: var(--md-sys-color-on-surface-variant);
  }

  .entry-body {
    display: grid;
    grid-template-columns: minmax(0, var(--content-width)) minmax(16rem, 20rem);
    gap: var(--space-5);
    align-items: start;
  }

  @media (max-width: 60rem) {
    .entry-body {
      grid-template-columns: 1fr;
    }
  }

  .meaning {
    padding: var(--space-3);
    border-radius: var(--shape-large);
    background: var(--md-sys-color-secondary-container);
    color: var(--md-sys-color-on-secondary-container);
  }

  .origin {
    margin-top: var(--space-1);
  }

  .variants {
    color: var(--md-sys-color-on-surface-variant);
  }

  .rail {
    position: sticky;
    top: var(--space-3);
    padding: var(--space-2) var(--space-1);
    border-radius: var(--shape-extra-large);
    background: var(--md-sys-color-surface-container-low);
  }

  .rail section {
    padding-block: var(--space-1);
  }

  .rail section + section {
    border-top: 1px solid var(--md-sys-color-outline-variant);
  }

  .rail h2 {
    padding: var(--space-1) var(--space-2) 0;
    color: var(--md-sys-color-on-surface-variant);
  }

  .rail md-list {
    --md-list-container-color: transparent;
    padding: 0;
  }

  .root-value,
  .none {
    padding: 0 var(--space-2);
  }

  .none {
    margin-top: var(--space-1);
    color: var(--md-sys-color-on-surface-variant);
  }
</style>
