---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import GenderMark from '../../components/GenderMark.astro';
import NameTree from '../../components/NameTree.astro';
import { genderMeta } from '../../lib/gender';
import { buildFamilies } from '../../lib/families';
import { useTranslations } from '../../i18n';

const t = useTranslations();
const names = await getCollection('names');
const { families, standalone } = buildFamilies(names);
const genders = Object.keys(genderMeta) as Array<keyof typeof genderMeta>;
---

<BaseLayout title={t('browse.title')} description="Browse every name in Onoma, grouped by family.">
  <h1 class="md-typescale-display-medium head">{t('browse.title')}</h1>
  <p class="count md-typescale-body-medium">{t('browse.count', { count: names.length })}</p>

  <ul class="legend" aria-label={t('legend.title')}>
    {
      genders.map((g) => (
        <li>
          <GenderMark gender={g} />
        </li>
      ))
    }
  </ul>

  <section>
    <h2 class="md-typescale-headline-small">{t('browse.families')}</h2>
    <p class="lead md-typescale-body-medium">{t('browse.familiesLead')}</p>
    <div class="families">
      {
        families.map((family) => (
          <article class="family">
            {family.roots.length > 0 && (
              <p class="roots md-typescale-label-medium">{family.roots.join(' · ')}</p>
            )}
            <NameTree nodes={family.trees} />
          </article>
        ))
      }
    </div>
  </section>

  <section class="standalone">
    <h2 class="md-typescale-headline-small">{t('browse.standalone')}</h2>
    <p class="lead md-typescale-body-medium">{t('browse.standaloneLead')}</p>
    <ul class="chips">
      {
        standalone.map((entry) => (
          <li>
            <md-assist-chip
              class={entry.data.gender}
              label={entry.data.name}
              href={`/names/${entry.id}/`}
            />
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>

<style>
  .head {
    padding-top: var(--space-5);
  }

  .count {
    margin-top: var(--space-1);
    color: var(--md-sys-color-on-surface-variant);
  }

  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    list-style: none;
    padding: 0;
    margin: var(--space-3) 0 var(--space-5);
  }

  section + section {
    margin-top: var(--space-6);
  }

  .lead {
    margin-top: 0.25rem;
    color: var(--md-sys-color-on-surface-variant);
  }

  .families {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(19rem, 1fr));
    gap: var(--space-2);
    margin-top: var(--space-3);
    align-items: start;
  }

  .family {
    padding: var(--space-2) var(--space-3) var(--space-2);
    border-radius: var(--md-sys-shape-corner-extra-large);
    background: var(--md-sys-color-surface-container-low);
    overflow-x: auto;
  }

  .roots {
    margin-bottom: var(--space-1);
    color: var(--md-sys-color-on-surface-variant);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    list-style: none;
    padding: 0;
    margin: var(--space-3) 0 0;
  }

  md-assist-chip {
    --md-assist-chip-container-shape: var(--md-sys-shape-corner-small);
  }

  .female {
    --md-assist-chip-container-color: var(--gender-female-container);
    --md-assist-chip-label-text-color: var(--gender-on-female-container);
    --md-assist-chip-outline-color: transparent;
  }

  .male {
    --md-assist-chip-container-color: var(--gender-male-container);
    --md-assist-chip-label-text-color: var(--gender-on-male-container);
    --md-assist-chip-outline-color: transparent;
  }

  .unisex {
    --md-assist-chip-container-color: var(--gender-unisex-container);
    --md-assist-chip-label-text-color: var(--gender-on-unisex-container);
    --md-assist-chip-outline-color: transparent;
  }
</style>
