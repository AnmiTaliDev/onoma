---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import GenderMark from '../../components/GenderMark.astro';
import { genderMeta } from '../../lib/gender';
import { useTranslations } from '../../i18n';

const t = useTranslations();
const names = (await getCollection('names')).sort((a, b) => a.data.name.localeCompare(b.data.name));
const genders = Object.keys(genderMeta) as Array<keyof typeof genderMeta>;
---

<BaseLayout title={t('browse.title')} description="Browse every name in Onoma, alphabetically.">
  <h1 class="md-typescale-display-medium head">{t('browse.title')}</h1>
  <p class="count md-typescale-body-medium">{t('browse.count', { count: names.length })}</p>

  <ul class="legend" aria-label={t('legend.title')}>
    {
      genders.map((g) => (
        <li>
          <GenderMark gender={g} />
        </li>
      ))
    }
  </ul>

  <md-list class="entries">
    {
      names.map((entry) => (
        <md-list-item type="link" href={`/names/${entry.id}/`}>
          <div slot="headline">{entry.data.name}</div>
          <div slot="supporting-text">{entry.data.origin}</div>
          <span slot="end">
            <GenderMark gender={entry.data.gender} />
          </span>
        </md-list-item>
      ))
    }
  </md-list>
</BaseLayout>

<style>
  .head {
    padding-top: var(--space-5);
  }

  .count {
    margin-top: var(--space-1);
    color: var(--md-sys-color-on-surface-variant);
  }

  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    list-style: none;
    padding: 0;
    margin: var(--space-3) 0;
  }

  .entries {
    --md-list-container-color: transparent;
    padding: 0;
  }
</style>
