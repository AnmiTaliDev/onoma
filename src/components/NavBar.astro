---
import Icon from './Icon.astro';
import { useTranslations } from '../i18n';

const t = useTranslations();
const path = Astro.url.pathname;
const items = [
  { href: '/', label: t('nav.homeLabel'), icon: 'home', current: path === '/' },
  { href: '/names/', label: t('nav.browse'), icon: 'list', current: path.startsWith('/names') },
  {
    href: '/random/',
    label: t('nav.random'),
    icon: 'shuffle',
    current: path.startsWith('/random'),
  },
] as const;
---

<nav class="nav" aria-label={t('nav.main')}>
  {
    items.map((item) => (
      <a class="item" href={item.href} aria-current={item.current ? 'page' : undefined}>
        <span class="indicator">
          <md-ripple />
          <md-icon>
            <Icon name={item.icon} />
          </md-icon>
        </span>
        <span class="label">{item.label}</span>
      </a>
    ))
  }
</nav>

<style>
  .nav {
    position: fixed;
    z-index: 10;
    inset: auto 0 0 0;
    height: var(--nav-size);
    display: flex;
    justify-content: space-around;
    align-items: flex-start;
    padding: 0.75rem 0.5rem 1rem;
    background: var(--md-sys-color-surface-container);
  }

  .item {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    color: var(--md-sys-color-on-surface-variant);
    text-decoration: none;
    outline: none;
  }

  .indicator {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 4rem;
    height: 2rem;
    border-radius: var(--md-sys-shape-corner-full);
    transition: background-color 200ms var(--md-sys-motion-easing-standard);
    --md-ripple-hover-color: var(--md-sys-color-on-surface);
    --md-ripple-pressed-color: var(--md-sys-color-on-surface);
  }

  .item:focus-visible .indicator {
    outline: 3px solid var(--md-sys-color-secondary);
    outline-offset: 2px;
  }

  .label {
    font: 500 0.75rem / 1rem var(--md-ref-typeface-plain);
    letter-spacing: 0.03125rem;
  }

  .item[aria-current='page'] {
    color: var(--md-sys-color-on-surface);
  }

  .item[aria-current='page'] .indicator {
    background: var(--md-sys-color-secondary-container);
    color: var(--md-sys-color-on-secondary-container);
  }

  @media (min-width: 600px) {
    .nav {
      inset: 0 auto 0 0;
      width: var(--nav-size);
      height: auto;
      flex-direction: column;
      justify-content: flex-start;
      align-items: stretch;
      gap: 0.75rem;
      padding: 5rem 0 1rem;
      background: var(--md-sys-color-surface);
    }

    .item {
      flex: none;
    }
  }
</style>
