---
interface Props {
  name:
    | 'home'
    | 'list'
    | 'shuffle'
    | 'palette'
    | 'dark_mode'
    | 'light_mode'
    | 'search'
    | 'arrow_forward';
}

const icons = import.meta.glob('../icons/*.svg', {
  query: '?raw',
  import: 'default',
  eager: true,
}) as Record<string, string>;

const svg = icons[`../icons/${Astro.props.name}.svg`];
---

<Fragment set:html={svg} />
