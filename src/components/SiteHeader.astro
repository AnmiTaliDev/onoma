---
import { useTranslations } from '../i18n';
import ThemeToggle from './ThemeToggle.astro';

const t = useTranslations();
const path = Astro.url.pathname;
const links = [
  { href: '/names/', label: t('nav.browse'), current: path.startsWith('/names') },
  { href: '/random/', label: t('nav.random'), current: path.startsWith('/random') },
];
---

<header class="app-bar">
  <div class="container bar">
    <a href="/" class="wordmark md-typescale-title-large">{t('nav.home')}</a>
    <nav aria-label={t('nav.browse')}>
      {
        links.map((link) =>
          link.current ? (
            <md-filled-tonal-button href={link.href} aria-current="page">
              {link.label}
            </md-filled-tonal-button>
          ) : (
            <md-text-button href={link.href}>{link.label}</md-text-button>
          ),
        )
      }
      <ThemeToggle />
    </nav>
  </div>
</header>

<style>
  .app-bar {
    background: var(--md-sys-color-surface-container);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 4rem;
  }

  .wordmark {
    color: var(--md-sys-color-on-surface);
    text-decoration: none;
  }

  nav {
    display: flex;
    align-items: center;
    gap: var(--space-1);
  }
</style>
