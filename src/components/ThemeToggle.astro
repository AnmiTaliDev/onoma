---
import Icon from './Icon.astro';
import { useTranslations } from '../i18n';

const t = useTranslations();
---

<md-icon-button id="theme-toggle" aria-label={t('nav.themeToggle')}>
  <md-icon data-state="light"><Icon name="dark_mode" /></md-icon>
  <md-icon data-state="dark"><Icon name="light_mode" /></md-icon>
</md-icon-button>

<script is:inline>
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const root = document.documentElement;
    const isDark = root.dataset.theme === 'dark';
    if (isDark) {
      delete root.dataset.theme;
      localStorage.setItem('theme', 'light');
    } else {
      root.dataset.theme = 'dark';
      localStorage.setItem('theme', 'dark');
    }
  });
</script>

<style>
  [data-state='dark'] {
    display: none;
  }

  :global([data-theme='dark']) [data-state='light'] {
    display: none;
  }

  :global([data-theme='dark']) [data-state='dark'] {
    display: inline-flex;
  }
</style>
