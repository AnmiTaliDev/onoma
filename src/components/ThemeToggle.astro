---
import { useTranslations } from '../i18n';

const t = useTranslations();
---

<md-icon-button id="theme-toggle" aria-label={t('nav.themeToggle')}>
  <md-icon data-state="light">
    <svg viewBox="0 -960 960 960" aria-hidden="true">
      <path
        d="M480-120q-150 0-255-105T120-480q0-150 105-255t255-105q14 0 27.5 1t26.5 3q-41 29-65.500 75.500T444-660q0 90 63 153t153 63q55 0 101-24.500t75-65.500q2 13 3 26.500t1 27.500q0 150-105 255T480-120Z"
      ></path>
    </svg>
  </md-icon>
  <md-icon data-state="dark">
    <svg viewBox="0 -960 960 960" aria-hidden="true">
      <path
        d="M480-360q50 0 85-35t35-85q0-50-35-85t-85-35q-50 0-85 35t-35 85q0 50 35 85t85 35Zm0 80q-83 0-141.500-58.500T280-480q0-83 58.500-141.500T480-680q83 0 141.500 58.500T680-480q0 83-58.500 141.500T480-280ZM200-440H40v-80h160v80Zm720 0H760v-80h160v80ZM440-760v-160h80v160h-80Zm0 720v-160h80v160h-80ZM256-650l-101-97 57-59 96 100-52 56Zm492 496-97-101 53-55 101 97-57 59Zm-98-550 97-101 59 57-100 96-56-52ZM154-212l101-97 55 53-97 101-59-57Z"
      ></path>
    </svg>
  </md-icon>
</md-icon-button>

<script is:inline>
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const root = document.documentElement;
    const isDark = root.dataset.theme === 'dark';
    if (isDark) {
      delete root.dataset.theme;
      localStorage.setItem('theme', 'light');
    } else {
      root.dataset.theme = 'dark';
      localStorage.setItem('theme', 'dark');
    }
  });
</script>

<style>
  [data-state='dark'] {
    display: none;
  }

  :global([data-theme='dark']) [data-state='light'] {
    display: none;
  }

  :global([data-theme='dark']) [data-state='dark'] {
    display: inline-flex;
  }
</style>
